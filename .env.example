HOST=127.0.0.1
PORT=8000

# Primary model (FREE)
MODEL_PROVIDER=gemini
MODEL_NAME=gemini-3.8-flash

# Secondary model for comparison (also FREE)
SECONDARY_PROVIDER=gemini
SECONDARY_MODEL=gemini-3.5-flash-lite

# API keys — get your FREE Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenAI is optional (paid) — leave blank if you don't have one
OPENAI_API_KEY=

# Execution limits
MAX_STEPS=6
MAX_TOOL_RETRIES=2
MAX_REPAIR_RETRIES=2
MAX_OUTPUT_TOKENS=512
RUN_TIMEOUT_SECONDS=40

# Context limits
HISTORY_MAX_MESSAGES=12
